NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://localhost:27017/adblogger

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=30d
JWT_COOKIE_EXPIRES_IN=30

# Admin credentials (initial seed)
ADMIN_EMAIL=admin@adbloger.uz
ADMIN_PASSWORD=Admin@123456

# Cloudinary (optional, Uzbekistonda ishlamaydi)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Backblaze B2 — asosiy file storage (bepul 10GB)
# https://www.backblaze.com/sign-up/cloud-storage
B2_KEY_ID=your_b2_key_id
B2_APPLICATION_KEY=your_b2_application_key
B2_BUCKET_NAME=your_bucket_name
B2_REGION=us-west-004

# Email (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=ADBlogger <noreply@adbloger.uz>

# Frontend URL (CORS) — vergul bilan bir nechta origin yozish mumkin
# CLIENT_URL=https://adbloger.uz,https://your-project.vercel.app
CLIENT_URL=http://localhost:5173
